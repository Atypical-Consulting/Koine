<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Roslyn compile-and-load harness for emitted C# (issue #236), lifted out of the test
       project's TestSupport so executing generated code is a product capability rather than a
       test-only trick. Deliberately NOT packable and NOT under the public-API contract gate: it is
       an internal building block for the scenario runner, not a shipped surface — the Koine.Emit.props
       import (which carries that gate) is for emitter projects only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koine.Compiler\Koine.Compiler.csproj" />
    <!-- The scenario executor (issue #236) emits the model's C# itself before compiling and running it,
         so it needs the C# backend — not the whole Koine.Emit.All aggregator, which would drag in eight
         further emitters this project never uses. -->
    <ProjectReference Include="..\Koine.Emit.CSharp\Koine.Emit.CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Koine.Compiler.Tests" />
    <!-- The CLI hosts the sandbox child (`koine scenario-exec`, #236 / ADR 0011), which drives the
         internal ScenarioExecutor and the internal stdio protocol shared with ScenarioExecutionHost. -->
    <InternalsVisibleTo Include="Koine.Cli" />
  </ItemGroup>

</Project>
