context Ordering {

  aggregate Sales root Order {

    enum OrderStatus { Draft, Placed, Shipped, Cancelled }

    value OrderLine {
      product:   ProductId
      quantity:  Int
      unitPrice: Decimal
      subtotal:  Decimal = unitPrice * quantity
    }

    entity Order identified by OrderId {
      lines:  List<OrderLine>
      status: OrderStatus = Draft

      states status {
        Draft   -> Placed
        Placed  -> Shipped
        Placed  -> Cancelled
      }

      command place {
        requires status == Draft   "only a draft order can be placed"
        status -> Placed
      }

      command ship {
        requires status == Placed  "only a placed order can be shipped"
        status -> Shipped
      }

      command cancel {
        requires status == Placed  "only a placed order can be cancelled"
        status -> Cancelled
      }
    }
  }
}
